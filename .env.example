# Supabase (obligatoire pour le cloud)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Cloudinary (RECOMMANDÉ - stocke les photos hors Supabase pour ne jamais saturer le quota)
# Créer un compte gratuit : https://cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=votre-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=votre-upload-preset

# Optionnel
VITE_APP_URL=http://localhost:3000
